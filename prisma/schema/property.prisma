model Property {
  id             String          @id @default(ulid())
  title          String
  description    String
  price          Decimal         @db.Decimal(10, 2)
  location       String
  address        String
  bedrooms       Int?
  bathrooms      Int?
  sizeSqft       Int?
  amenities      String[]
  images         String[]
  status         PropertyStatus  @default(AVAILABLE)
  landLordId     String
  landLord       Users           @relation(fields: [landLordId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rentalRequests RentalRequest[]
  reviews        Reviews[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([landLordId])
  @@index([categoryId])
  @@index([location])
  @@index([price])
  @@map("properties")
}
